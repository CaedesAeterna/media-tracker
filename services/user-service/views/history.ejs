<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>History - Media Tracker</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary mb-4">
        <div class="container">
            <a class="navbar-brand" href="/">Media Tracker</a>
            <div class="collapse navbar-collapse">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item"><a class="nav-link" href="/media">Browse</a></li>
                    <li class="nav-item"><a class="nav-link active" href="/library">My Library</a></li>
                    <li class="nav-item"><a class="nav-link" href="/friends">Friends</a></li>
                    <li class="nav-item"><a class="nav-link" href="/dashboard">Dashboard</a></li>
                </ul>
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item"><a class="nav-link" href="/profile">Hi, <%= username %></a></li>
                    <li class="nav-item"><a class="nav-link" href="/auth/logout">Logout</a></li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1><%= filterTitle ? 'Activity History: ' + filterTitle : 'Global Activity History' %></h1>
            <a href="/library" class="btn btn-outline-secondary">&larr; Back to Library</a>
        </div>

        <div class="card shadow-sm">
            <div class="card-body p-0">
                <table class="table table-striped mb-0">
                    <thead>
                        <tr>
                            <th>Time</th>
                            <th>Title</th>
                            <th>Action</th>
                            <th>Details</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% history.forEach(function(item) { %>
                            <tr>
                                <td style="white-space: nowrap;"><%= new Date(item.created_at).toLocaleString() %></td>
                                <td class="fw-bold"><%= item.media_title %></td>
                                <td>
                                    <% if (item.action_type === 'ADDED') { %>
                                        <span class="badge bg-success">Added</span>
                                    <% } else if (item.action_type === 'UPDATED') { %>
                                        <span class="badge bg-primary">Updated</span>
                                    <% } else { %>
                                        <span class="badge bg-secondary"><%= item.action_type %></span>
                                    <% } %>
                                </td>
                                <td><%= item.details %></td>
                            </tr>
                        <% }); %>
                        <% if (history.length === 0) { %>
                            <tr>
                                <td colspan="4" class="text-center p-4 text-muted">No activity recorded yet.</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</body>
</html>
