<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title><%= title %> - Media Tracker</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary mb-4">
        <div class="container">
            <a class="navbar-brand" href="/">Media Tracker</a>
            <div class="collapse navbar-collapse">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item"><a class="nav-link" href="/media">Browse</a></li>
                    <li class="nav-item"><a class="nav-link" href="/library">My Library</a></li>
                    <li class="nav-item"><a class="nav-link" href="/friends">Friends</a></li>
                    <li class="nav-item"><a class="nav-link" href="/dashboard">Dashboard</a></li>
                </ul>
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item"><a class="nav-link active" href="/profile">Hi, <%= username %></a></li>
                    <li class="nav-item"><a class="nav-link" href="/auth/logout">Logout</a></li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container">
        <div class="row mb-4">
            <div class="col-md-12">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h2 class="card-title">@<%= username %></h2>
                                <p class="text-muted mb-1"><%= user.email || 'No email set' %></p>
                                <p><%= user.bio || 'No bio yet.' %></p>
                            </div>
                            <a href="/profile/edit" class="btn btn-outline-primary">Edit Profile</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <!-- User Info Card -->
            <div class="col-md-4 mb-4">
                <div class="card shadow-sm text-center p-4">
                    <div class="mb-3">
                        <!-- Placeholder Avatar -->
                        <div style="width: 100px; height: 100px; background-color: #ddd; border-radius: 50%; margin: 0 auto; display: flex; align-items: center; justify-content: center; font-size: 2em; color: #555;">
                            <%= username.charAt(0).toUpperCase() %>
                        </div>
                    </div>
                    <h3><%= username %></h3>
                    <p class="text-muted">Member since <%= new Date(user.created_at).toLocaleDateString() %></p>
                </div>
            </div>

            <!-- Stats Column -->
            <div class="col-md-8">
                <div class="row g-4">
                    <!-- Total Stats -->
                    <div class="col-md-6">
                        <div class="card shadow-sm h-100">
                            <div class="card-body text-center">
                                <h5 class="card-title text-muted">Total Consumed</h5>
                                <h2 class="display-4 text-primary"><%= stats.total %></h2>
                                <p>Items tracked</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="card shadow-sm h-100">
                            <div class="card-body text-center">
                                <h5 class="card-title text-muted">Average Rating</h5>
                                <h2 class="display-4 text-warning"><%= stats.avgRating %></h2>
                                <p>Stars</p>
                            </div>
                        </div>
                    </div>

                    <!-- Breakdown by Type -->
                    <div class="col-12">
                        <div class="card shadow-sm">
                            <div class="card-header bg-white">
                                <h5 class="mb-0">Breakdown by Type</h5>
                            </div>
                            <div class="card-body">
                                <ul class="list-group list-group-flush">
                                    <% for (const [type, count] of Object.entries(stats.byType)) { %>
                                        <li class="list-group-item d-flex justify-content-between align-items-center">
                                            <%= type %>
                                            <span class="badge bg-primary rounded-pill"><%= count %></span>
                                        </li>
                                    <% } %>
                                    <% if (Object.keys(stats.byType).length === 0) { %>
                                        <li class="list-group-item text-muted">No data yet.</li>
                                    <% } %>
                                </ul>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Breakdown by Status -->
                    <div class="col-12">
                        <div class="card shadow-sm">
                            <div class="card-header bg-white">
                                <h5 class="mb-0">Status Overview</h5>
                            </div>
                            <div class="card-body">
                                <div class="d-flex justify-content-around text-center">
                                    <div>
                                        <h4 class="text-success"><%= stats.byStatus['Completed'] || 0 %></h4>
                                        <small>Completed</small>
                                    </div>
                                    <div>
                                        <h4 class="text-info"><%= stats.byStatus['Watching'] || 0 %></h4>
                                        <small>Active</small>
                                    </div>
                                    <div>
                                        <h4 class="text-secondary"><%= stats.byStatus['Plan to Watch'] || 0 %></h4>
                                        <small>Planned</small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</body>
</html>
