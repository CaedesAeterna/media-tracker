<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body class="bg-light">
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary mb-5">
        <div class="container">
            <a class="navbar-brand" href="/">Media Tracker</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item"><a class="nav-link" href="/media">Browse</a></li>
                    <li class="nav-item"><a class="nav-link" href="/library">My Library</a></li>
                    <li class="nav-item"><a class="nav-link" href="/friends">Friends</a></li>
                    <li class="nav-item"><a class="nav-link" href="/dashboard">Dashboard</a></li>
                </ul>
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item"><a class="nav-link" href="/profile"><%= user.username %></a></li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container">
        <!-- Profile Header -->
        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <div class="row align-items-center">
                    <div class="col-auto">
                        <div class="bg-secondary text-white rounded-circle d-flex justify-content-center align-items-center" style="width: 100px; height: 100px; font-size: 3rem;">
                            <%= targetUser.username.charAt(0).toUpperCase() %>
                        </div>
                    </div>
                    <div class="col">
                        <h2 class="mb-1"><%= targetUser.username %></h2>
                        <p class="text-muted mb-2"><%= targetUser.bio || "No bio yet." %></p>
                        
                        <% if (friendshipStatus === 'self') { %>
                            <span class="badge bg-secondary">That's You!</span>
                            <a href="/profile/edit" class="btn btn-sm btn-outline-secondary ms-2">Edit Profile</a>
                        <% } else if (friendshipStatus === 'accepted') { %>
                            <span class="badge bg-success"><i class="fas fa-check"></i> Friend</span>
                        <% } else if (friendshipStatus === 'pending') { %>
                            <span class="badge bg-warning text-dark"><i class="fas fa-clock"></i> Request Pending</span>
                        <% } else { %>
                            <form action="/friends/request" method="POST" class="d-inline">
                                <input type="hidden" name="target_username" value="<%= targetUser.username %>">
                                <button type="submit" class="btn btn-sm btn-primary"><i class="fas fa-user-plus"></i> Add Friend</button>
                            </form>
                        <% } %>
                    </div>
                    <% if (canViewLibrary && stats) { %>
                    <div class="col-md-4 text-end">
                        <div class="row text-center">
                            <div class="col">
                                <h4 class="mb-0"><%= stats.total %></h4>
                                <small class="text-muted">Items</small>
                            </div>
                            <div class="col">
                                <h4 class="mb-0"><%= stats.avgRating %></h4>
                                <small class="text-muted">Avg Rating</small>
                            </div>
                        </div>
                    </div>
                    <% } %>
                </div>
            </div>
        </div>

        <!-- Library View (If Allowed) -->
        <% if (canViewLibrary) { %>
            <h3 class="mb-3">Library</h3>
            <% if (library.length === 0) { %>
                <div class="alert alert-info">
                    <%= targetUser.username %> hasn't added anything yet.
                </div>
            <% } else { %>
                <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
                    <% library.forEach(item => { %>
                    <div class="col">
                        <div class="card h-100 shadow-sm">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <h5 class="card-title text-truncate" title="<%= item.media_title %>">
                                        <%= item.media_title %>
                                    </h5>
                                    <span class="badge bg-info text-dark"><%= item.media_type %></span>
                                </div>
                                
                                <div class="mb-2">
                                    <span class="badge bg-secondary"><%= item.status %></span>
                                    <% if (item.rating > 0) { %>
                                        <span class="text-warning ms-1">
                                            <% for(let i=0; i<item.rating; i++) { %>★<% } %>
                                        </span>
                                    <% } %>
                                </div>

                                <% if (item.review_text) { %>
                                    <div class="bg-light p-2 rounded fst-italic mb-2 border-start border-4 border-primary">
                                        "<%= item.review_text %>"
                                    </div>
                                <% } %>

                                <div class="text-muted small">
                                    <% 
                                        const isReading = ['Book', 'Novel', 'Manga', 'Web Novel'].includes(item.media_type);
                                        const dateLabel = isReading ? "Read" : "Watched";
                                        const rewatchLabel = isReading ? "Reread" : "Rewatch";
                                    %>
                                    <% if (item.watched_date) { %>
                                        <div title="Date <%= dateLabel %>"><i class="fas fa-calendar-alt"></i> <%= new Date(item.watched_date).toLocaleDateString() %></div>
                                    <% } %>
                                    <% if (item.is_rewatch) { %>
                                        <div><i class="fas fa-redo"></i> <%= rewatchLabel %></div>
                                    <% } %>
                                </div>
                            </div>
                        </div>
                    </div>
                    <% }) %>
                </div>
            <% } %>
        <% } else { %>
            <div class="text-center py-5">
                <i class="fas fa-lock fa-3x text-muted mb-3"></i>
                <h4>This library is private.</h4>
                <p class="text-muted">You need to be friends with <%= targetUser.username %> to see their library.</p>
            </div>
        <% } %>
    </div>
    
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
